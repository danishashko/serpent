{
  "name": "serpent",
  "version": "1.0.7",
  "description": "AI-native local SEO spider — a free, open-source technical SEO crawler",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\" \"electronmon .\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "dist": "npm run build && electron-builder",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:installer": "playwright test --config playwright.installer.config.ts e2e-installer/tests/01-packed-app.spec.ts",
    "test:installer:full": "playwright test --config playwright.installer.config.ts",
    "electron-rebuild": "electron-rebuild"
  },
  "keywords": [
    "seo",
    "crawler",
    "spider",
    "electron",
    "seo-audit"
  ],
  "author": "Daniel Shashko <daniel@organikpi.com>",
  "license": "MIT",
  "homepage": "https://github.com/danishashko/serpent",
  "repository": {
    "type": "git",
    "url": "https://github.com/danishashko/serpent.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.1.2",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "electronmon": "^2.0.3",
    "jimp": "^1.6.0",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.8.3",
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.0.0",
    "electron-updater": "^6.8.3",
    "keytar": "^7.9.0",
    "p-queue": "^7.4.1",
    "playwright-core": "^1.59.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "com.organikpi.serpent",
    "productName": "Serpent",
    "copyright": "Copyright © 2026 Daniel Shashko",
    "directories": {
      "output": "release"
    },
    "compression": "normal",
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "signtoolOptions": {
        "publisherName": "Daniel Shashko"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "danishashko",
      "repo": "serpent"
    }
  },
  "electronmon": {
    "patterns": [
      "dist/**"
    ],
    "logLevel": "quiet"
  }
}
